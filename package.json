{
  "name": "himalayan-archive",
  "version": "1.0.0",
  "description": "Publish a manuscript archive to Swarm behind a feed, and recover it from nothing but its published address.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "archive": "./dist/cli/index.js"
  },
  "scripts": {
    "archive": "tsx src/cli/index.ts",
    "recover": "tsx src/recover/main.ts",
    "serve": "tsx src/cli/index.ts serve",
    "ui": "vite",
    "dev": "vite",
    "make:samples": "tsx scripts/make-samples.ts",
    "build:reader": "tsx scripts/build-reader.ts",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:web": "vite build",
    "build": "npm run build:reader && npm run build:cli && npm run build:web",
    "typecheck": "tsc -p tsconfig.cli.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run check:secrets",
    "preview:edition": "tsx scripts/preview-edition.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ethersphere/bee-js": "13.1.0",
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-serif-tibetan": "5.3.0",
    "@fontsource/rozha-one": "5.3.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
