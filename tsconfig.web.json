{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.tsx", "reader/swarm-lite.d.ts"]
}
