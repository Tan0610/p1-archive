# Copy to .env (gitignored). Never put a private key, mnemonic or gift code in a tracked file.
# Your Swarm gift code belongs in Swarm Desktop (Info -> Setup wallet) and nowhere else.

# Your local Bee node (Swarm Desktop exposes it here)
BEE_URL=http://localhost:1633

# Public, read-only gateway used for recovery / verification
GATEWAY_URL=https://api.gateway.ethswarm.org

# Human-readable feed topic (hashed with keccak256 into the 32-byte topic)
FEED_TOPIC=tsering/himalayan-manuscripts/v1

# Optional: feed signing key (64 hex). Leave empty and the tool creates .secrets/feed-key.hex (gitignored).
FEED_PRIVATE_KEY=

# Optional: folder of scans to publish (default samples/folios) and the title on the gallery page
# FOLIOS_DIR=path/to/scans
# ARCHIVE_TITLE=The Spiti Folios — scans by Tsering
